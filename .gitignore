# This .gitignore file should be placed at the root of your Unity project directory
# Unityプロジェクトのルートディレクトリに配置する.gitignoreファイル

# Unity が自動生成するフォルダ（不要）
# Automatically generated folders by Unity (unnecessary)
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Unity Cache
# Unity cache directories
/[Bb]uildCache/
/Artifacts/

# IDE files
# IDE specific files
.vs/
.idea/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.log
*.DotSettings.user

# OS specific files
# OS specific files
.DS_Store
Thumbs.db

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Unity generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta
*.blend1.meta
*.unitypackage.meta

# Unity3D generated file on crash reports
sysinfo.txt

# Mono auto generated files
mono_crash.*

# Builds
*.apk
*.aab
*.unitypackage
*.app
*.blend1

# Crashlytics generated file
crashlytics-build.properties

# TestRunner generated files
InitTestScene*.unity*

# Addressables default ignores, before user customizations
/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/Addressables_Temp*

# Visual Scripting auto-generated files
/[Aa]ssets/Unity.VisualScripting.Generated/

# Auto-generated scenes by play mode tests
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# Uncomment this line if you wish to ignore the asset store tools plugin
# アセットストアツールプラグインを無視したい場合はこの行のコメントを解除
# /[Aa]ssets/AssetStoreTools*

# TextMesh Pro
Assets/TextMesh Pro/
Assets/AssetStoreTools/
